{
  "name": "watza/attribute-heatmap-bundle",
  "license": "MIT",
  "type": "pimcore-bundle",
  "description": "Pimcore Studio bundle that visualizes the usage of data object attributes as a heatmap",
  "homepage": "https://github.com/Waaatza/pimcore-attribute-heatmap-bundle",
  "support": {
    "source": "https://github.com/Waaatza/pimcore-attribute-heatmap-bundle"
  },
  "keywords": [
    "pimcore",
    "pimcore-studio",
    "bundle",
    "heatmap",
    "data-objects"
  ],
  "require": {
    "php": ">=8.4",
    "pimcore/pimcore": "^2026.1",
    "pimcore/studio-backend-bundle": "^2026.2",
    "pimcore/studio-ui-bundle": "^2026.2",
    "pimcore/static-resolver-bundle": "^2026.2"
  },
  "autoload": {
    "psr-4": {
      "Watza\\AttributeHeatmapBundle\\": "src/"
    }
  },
  "extra": {
    "pimcore": {
      "compatible-php-versions": "^8.4",
      "bundles": [
        "Watza\\AttributeHeatmapBundle\\PimcoreAttributeHeatmapBundle"
      ]
    }
  }
}
